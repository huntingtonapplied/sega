# Prometheus Configuration for Fleet Monitoring
# Generated by SEGA Ansible role: configure_monitoring

global:
  scrape_interval: {{ scrape_interval | default('15s') }}
  evaluation_interval: {{ evaluation_interval | default('15s') }}

scrape_configs:
  - job_name: 'prometheus'
    static_configs:
      - targets: ['localhost:9090']

  - job_name: 'metrics'
    static_configs:
      - targets: ['{{ metrics_host | default('localhost') }}:9003']

{% for project in monitored_projects | default([]) %}
  - job_name: '{{ project.name }}'
    static_configs:
      - targets: ['{{ project.host | default('localhost') }}:{{ project.metrics_port }}']
{% endfor %}

  - job_name: 'node'
    static_configs:
      - targets: ['localhost:9100']
