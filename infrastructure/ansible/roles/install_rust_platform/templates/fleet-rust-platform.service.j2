[Unit]
Description=Rust Platform - {{ project_name | default('atlas') }}
After=network.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ install_path | default('/opt/example') }}/{{ project_name | default('atlas') }}
ExecStart=/usr/bin/docker-compose up -d
ExecStop=/usr/bin/docker-compose down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
