# Rust Platform - Docker Compose Configuration
# Generated by SEGA Ansible role: install_rust_platform

version: '3.8'

services:
  {{ project_name | default('atlas') }}-backend:
    image: {{ registry | default('registry.gitlab.com/example') }}/{{ project_name | default('atlas') }}:{{ version | default('latest') }}
    container_name: example-{{ project_name | default('atlas') }}-backend
    restart: unless-stopped
    ports:
      - "{{ api_port | default('8007') }}:{{ api_port | default('8007') }}"
    environment:
      - RUST_LOG={{ rust_log | default('info') }}
      - DATABASE_URL=postgres://{{ db_user | default('example') }}:{{ db_password }}@postgres:5432/{{ db_name | default('example') }}
      - REDIS_URL=redis://redis:6379
{% if metrics_enabled | default(true) %}
      - METRICS_ENDPOINT={{ metrics_endpoint | default('http://metrics:3308') }}
{% endif %}
    volumes:
      - {{ data_root | default('/opt/example/data') }}/{{ project_name | default('atlas') }}:/app/data
    networks:
      - example-network
    depends_on:
      - postgres
      - redis

  postgres:
    image: postgres:13
    container_name: example-{{ project_name | default('atlas') }}-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER={{ db_user | default('example') }}
      - POSTGRES_PASSWORD={{ db_password }}
      - POSTGRES_DB={{ db_name | default('example') }}
    volumes:
      - {{ data_root | default('/opt/example/data') }}/postgres:/var/lib/postgresql/data
    networks:
      - example-network

  redis:
    image: redis:7-alpine
    container_name: example-{{ project_name | default('atlas') }}-redis
    restart: unless-stopped
    volumes:
      - {{ data_root | default('/opt/example/data') }}/redis:/data
    networks:
      - example-network

networks:
  example-network:
    external: true
