# Omni Platform - All Fleet Projects
# Generated by SEGA Ansible role: install_omni_platform

version: '3.8'

services:
{% for project in fleet_projects %}
  {{ project.name }}:
    image: {{ registry | default('registry.gitlab.com/example') }}/{{ project.name }}:{{ version | default('latest') }}
    container_name: example-{{ project.name }}
    restart: unless-stopped
    ports:
      - "{{ project.api_port }}:{{ project.api_port }}"
    environment:
      - DATABASE_URL=postgres://{{ db_user | default('example') }}:{{ db_password }}@postgres:5432/{{ project.name }}
      - REDIS_URL=redis://redis:6379
      - METRICS_ENDPOINT=http://metrics:3308
    volumes:
      - {{ data_root | default('/opt/example/data') }}/{{ project.name }}:/app/data
    networks:
      - example-network
    depends_on:
      - postgres
      - redis
{% if project.name != 'metrics' %}
      - metrics
{% endif %}

{% endfor %}
  postgres:
    image: postgres:13
    container_name: example-postgres
    restart: unless-stopped
    environment:
      - POSTGRES_USER={{ db_user | default('example') }}
      - POSTGRES_PASSWORD={{ db_password }}
    volumes:
      - {{ data_root | default('/opt/example/data') }}/postgres:/var/lib/postgresql/data
    networks:
      - example-network

  redis:
    image: redis:7-alpine
    container_name: example-redis
    restart: unless-stopped
    networks:
      - example-network

networks:
  example-network:
    external: true
