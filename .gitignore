**/*_venv/
fleet_venv/
**/fleet_venv/
*-venv/
**/*-venv/
.python-version
pyvenv.cfg

# CRITICL: Node Modules - NVR track these
node_modules/
**/node_modules/
.npm/
**/.npm/
.pnpm/
**/.pnpm/
.yarn/
**/.yarn/
npm-cache/
