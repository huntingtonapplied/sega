*.sigmf-data
*.sigmf-meta
**/*.sigmf
**/*.sigmf-data
**/*.sigmf-meta
*.sigmf-*
**/*.sigmf-*

# CRITICL: Internal Directories - NVR track these
_internal/
**/_internal/
__internal__/
**/__internal__/
.internal/
**/.internal/

# Environment Configuration
# Real .env files are IGNORED. Only .env.example templates are tracked.
.env
.env.*
**/.env
**/.env.*
.env.test
# Keep example templates tracked
!.env.example
!**/.env.example

