# Unified Server - Simple Development Configuration
# Generated by SEGA Infrastructure Management
# Generated: {{ timestamp | default('') }}
# Optimized for local development and testing

# Main server - Path-based routing for simplicity
server {
    listen 80;
    server_name {{ domain | default('localhost') }};

    # Basic security headers
    add_header X-Frame-Options DENY;
    add_header X-Content-Type-Options nosniff;

    # Global proxy settings
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # WebSocket support for development servers
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # Health check
    location /health {
        access_log off;
        return 200 "Unified Server: healthy\n";
        add_header Content-Type text/plain;
    }

    # API Services
{% for project_name, project in projects.items() %}
{% if project.ports.api %}
    location /api/{{ project_name }}/ { proxy_pass http://127.0.0.1:{{ project.ports.api }}/; }
{% endif %}
{% endfor %}

    # Frontend Services
{% for project_name, project in projects.items() %}
{% if project.has_frontend and project.ports.frontend %}
    location /{{ project_name }}/ { proxy_pass http://127.0.0.1:{{ project.ports.frontend }}/; }
{% endif %}
{% endfor %}

    # Mobile Services
{% for project_name, project in projects.items() %}
{% if project.has_mobile and project.ports.mobile %}
    location /mobile/{{ project_name }}/ { proxy_pass http://127.0.0.1:{{ project.ports.mobile }}/; }
{% endif %}
{% endfor %}

    # Desktop Development Services
{% for project_name, project in projects.items() %}
{% if project.has_desktop and project.ports.desktop %}
    location /desktop/{{ project_name }}/ { proxy_pass http://127.0.0.1:{{ project.ports.desktop }}/; }
{% endif %}
{% endfor %}

    # Root path - Service directory
    location = / {
        return 200 "Unified Server\n\nAvailable Services:\n\nAPIs:\n{% for project_name, project in projects.items() %}{% if project.ports.api %}/api/{{ project_name }}/\n{% endif %}{% endfor %}\nFrontends:\n{% for project_name, project in projects.items() %}{% if project.has_frontend %}/{{ project_name }}/\n{% endif %}{% endfor %}\nMobile:\n/mobile/[project]/\n\nDesktop:\n/desktop/[project]/\n\nHealth: /health\n";
        add_header Content-Type text/plain;
    }

    # 404 for unknown paths
    location / {
        return 404 "Service not found. Visit / for available services.\n";
        add_header Content-Type text/plain;
    }
}

# Connection upgrade map for WebSocket support
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
