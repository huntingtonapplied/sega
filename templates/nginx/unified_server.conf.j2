# FLEET Unified Server - Nginx Configuration
# Generated by SEGA Infrastructure Management
# Configuration: {{ config.unified_server.name }}
# Generated: {{ timestamp }}

# Rate limiting zones
{% if config.security.rate_limiting.enabled %}
limit_req_zone $binary_remote_addr zone=api:10m rate={{ config.security.rate_limiting.requests_per_minute }}r/m;
limit_req_zone $binary_remote_addr zone=frontend:10m rate={{ config.security.rate_limiting.requests_per_minute }}r/m;
{% endif %}

# Upstream definitions for load balancing (future expansion)
{% for project_name, project in config.projects.items() %}
{% for service_name, service in project.services.items() %}
upstream {{ project_name }}_{{ service_name }} {
    server 127.0.0.1:{{ service.port }} max_fails=3 fail_timeout=30s;
    # Additional servers can be added here for load balancing
}
{% endfor %}
{% endfor %}

# Main server block - Subdomain routing
server {
    {% if config.unified_server.server.ssl.enabled %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    
    ssl_certificate {{ config.unified_server.server.ssl.cert_path }};
    ssl_certificate_key {{ config.unified_server.server.ssl.key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-RSA-AES256-GCM-SHA512:DHE-RSA-AES256-GCM-SHA512:ECDHE-RSA-AES256-GCM-SHA384:DHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}
    
    server_name *.{{ config.unified_server.server.domain }};
    
    # Security headers
    {% for header in config.security.headers %}
    add_header {{ header }};
    {% endfor %}
    
    # CORS headers
    {% if config.security.cors.enabled %}
    add_header Access-Control-Allow-Origin "{{ config.security.cors.allowed_origins | join(' ') }}";
    add_header Access-Control-Allow-Methods "{{ config.security.cors.allowed_methods | join(', ') }}";
    add_header Access-Control-Allow-Headers "{{ config.security.cors.allowed_headers | join(', ') }}";
    {% endif %}
    
    # Global proxy settings
    {% for header in config.unified_server.reverse_proxy.proxy_settings.proxy_set_header %}
    proxy_set_header {{ header }};
    {% endfor %}
    proxy_connect_timeout {{ config.unified_server.reverse_proxy.proxy_settings.proxy_connect_timeout }};
    proxy_send_timeout {{ config.unified_server.reverse_proxy.proxy_settings.proxy_send_timeout }};
    proxy_read_timeout {{ config.unified_server.reverse_proxy.proxy_settings.proxy_read_timeout }};
    
    # Static files
    {% if config.unified_server.static_files.enabled %}
    location /assets/ {
        alias {{ config.unified_server.static_files.assets_path }}/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    
    location /favicon.ico {
        alias {{ config.unified_server.static_files.assets_path }}/favicon.ico;
        expires 1y;
    }
    {% endif %}
    
    # Health check endpoint
    {% if config.monitoring.enabled %}
    location {{ config.monitoring.health_check_path }} {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
    {% endif %}
    
    # Project routing based on subdomain
    {% for project_name, project in config.projects.items() %}
    {% for service_name, service in project.services.items() %}
    
    # {{ project.description }} - {{ service_name }}
    {% if service_name == 'frontend' %}
    # Frontend service (subdomain: {{ service.subdomain }}.{{ config.unified_server.server.domain }})
    if ($host = "{{ service.subdomain }}.{{ config.unified_server.server.domain }}") {
        set $backend {{ project_name }}_{{ service_name }};
    }
    {% elif service_name == 'api' %}
    # API service (subdomain: {{ service.subdomain }}.{{ config.unified_server.server.domain }})
    if ($host = "{{ service.subdomain }}.{{ config.unified_server.server.domain }}") {
        set $backend {{ project_name }}_{{ service_name }};
    }
    {% elif service_name == 'mobile' %}
    # Mobile service (subdomain: {{ service.subdomain }}.{{ config.unified_server.server.domain }})
    if ($host = "{{ service.subdomain }}.{{ config.unified_server.server.domain }}") {
        set $backend {{ project_name }}_{{ service_name }};
    }
    {% elif service_name == 'desktop' %}
    # Desktop service (subdomain: {{ service.subdomain }}.{{ config.unified_server.server.domain }})
    if ($host = "{{ service.subdomain }}.{{ config.unified_server.server.domain }}") {
        set $backend {{ project_name }}_{{ service_name }};
    }
    {% endif %}
    {% endfor %}
    {% endfor %}
    
    # Default proxy pass with dynamic backend
    location / {
        {% if config.security.rate_limiting.enabled %}
        limit_req zone=frontend burst={{ config.security.rate_limiting.burst_size }} nodelay;
        {% endif %}
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Proxy to dynamic backend
        proxy_pass http://$backend;
        
        # Fallback for unknown subdomains
        error_page 502 503 504 @fallback;
    }
    
    # API endpoints with rate limiting
    location /api/ {
        {% if config.security.rate_limiting.enabled %}
        limit_req zone=api burst={{ config.security.rate_limiting.burst_size }} nodelay;
        {% endif %}
        
        proxy_pass http://$backend;
        error_page 502 503 504 @fallback;
    }
    
    # Fallback for unavailable services
    location @fallback {
        return 503 "Service temporarily unavailable\n";
        add_header Content-Type text/plain;
    }
}

# Path-based routing server (fallback)
{% if config.routing.path.enabled %}
server {
    {% if config.unified_server.server.ssl.enabled %}
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    
    ssl_certificate {{ config.unified_server.server.ssl.cert_path }};
    ssl_certificate_key {{ config.unified_server.server.ssl.key_path }};
    {% else %}
    listen 80;
    listen [::]:80;
    {% endif %}
    
    server_name {{ config.unified_server.server.domain }};
    
    # Security headers
    {% for header in config.security.headers %}
    add_header {{ header }};
    {% endfor %}
    
    # Static files
    {% if config.unified_server.static_files.enabled %}
    location /assets/ {
        alias {{ config.unified_server.static_files.assets_path }}/;
        expires 1y;
    }
    {% endif %}
    
    # Health check
    {% if config.monitoring.enabled %}
    location {{ config.monitoring.health_check_path }} {
        access_log off;
        return 200 "healthy\n";
        add_header Content-Type text/plain;
    }
    {% endif %}
    
    # API path routing
    {% for project_name, project in config.projects.items() %}
    {% if 'api' in project.services %}
    location {{ project.services.api.path }}/ {
        {% if config.security.rate_limiting.enabled %}
        limit_req zone=api burst={{ config.security.rate_limiting.burst_size }} nodelay;
        {% endif %}
        
        rewrite ^{{ project.services.api.path }}/(.*) /$1 break;
        proxy_pass http://{{ project_name }}_api;
        
        # Global proxy settings
        {% for header in config.unified_server.reverse_proxy.proxy_settings.proxy_set_header %}
        proxy_set_header {{ header }};
        {% endfor %}
    }
    {% endif %}
    {% endfor %}
    
    # Mobile path routing
    {% for project_name, project in config.projects.items() %}
    {% if 'mobile' in project.services %}
    location {{ config.routing.path.mobile_prefix }}/{{ project_name }}/ {
        {% if config.security.rate_limiting.enabled %}
        limit_req zone=frontend burst={{ config.security.rate_limiting.burst_size }} nodelay;
        {% endif %}
        
        rewrite ^{{ config.routing.path.mobile_prefix }}/{{ project_name }}/(.*) /$1 break;
        proxy_pass http://{{ project_name }}_mobile;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Global proxy settings
        {% for header in config.unified_server.reverse_proxy.proxy_settings.proxy_set_header %}
        proxy_set_header {{ header }};
        {% endfor %}
    }
    {% endif %}
    {% endfor %}
    
    # Desktop path routing  
    {% for project_name, project in config.projects.items() %}
    {% if 'desktop' in project.services %}
    location {{ config.routing.path.desktop_prefix }}/{{ project_name }}/ {
        {% if config.security.rate_limiting.enabled %}
        limit_req zone=frontend burst={{ config.security.rate_limiting.burst_size }} nodelay;
        {% endif %}
        
        rewrite ^{{ config.routing.path.desktop_prefix }}/{{ project_name }}/(.*) /$1 break;
        proxy_pass http://{{ project_name }}_desktop;
        
        # WebSocket support for desktop dev servers
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Global proxy settings
        {% for header in config.unified_server.reverse_proxy.proxy_settings.proxy_set_header %}
        proxy_set_header {{ header }};
        {% endfor %}
    }
    {% endif %}
    {% endfor %}
    
    # Frontend path routing (default projects)
    {% for project_name, project in config.projects.items() %}
    {% if 'frontend' in project.services %}
    location /{{ project_name }}/ {
        {% if config.security.rate_limiting.enabled %}
        limit_req zone=frontend burst={{ config.security.rate_limiting.burst_size }} nodelay;
        {% endif %}
        
        rewrite ^/{{ project_name }}/(.*) /$1 break;
        proxy_pass http://{{ project_name }}_frontend;
        
        # WebSocket support for hot reload
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Global proxy settings
        {% for header in config.unified_server.reverse_proxy.proxy_settings.proxy_set_header %}
        proxy_set_header {{ header }};
        {% endfor %}
    }
    {% endif %}
    {% endfor %}
    
    # Root redirects to available services
    location = / {
        return 200 "FLEET Unified Server - Available Services\n";
        add_header Content-Type text/plain;
    }
}
{% endif %}

# HTTP redirect to HTTPS (if SSL enabled)
{% if config.unified_server.server.ssl.enabled %}
server {
    listen 80;
    listen [::]:80;
    server_name *.{{ config.unified_server.server.domain }} {{ config.unified_server.server.domain }};
    return 301 https://$server_name$request_uri;
}
{% endif %}