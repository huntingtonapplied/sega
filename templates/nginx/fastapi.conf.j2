# FastAPI optimized nginx configuration for {{ project_name }}
# Generated by SEGA on {{ timestamp }}

{% if ssl %}
# HTTP to HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};
    return 301 https://$server_name$request_uri;
}

# HTTPS server block
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ domain }};
    
{% else %}
# HTTP server block
server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }};
    
{% endif %}
    # Security headers for API
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer" always;
    
    # Gzip compression for JSON responses
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        application/json
        application/javascript
        text/css
        text/xml
        application/xml;

    # FastAPI application
    location / {
        proxy_pass http://127.0.0.1:{{ backend_port or 8000 }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $server_name;
        
        # CORS headers for API
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE, PATCH' always;
        add_header 'Access-Control-Allow-Headers' 'Origin, X-Requested-With, Content-Type, Accept, Authorization, Cache-Control' always;
        
        # Handle preflight requests
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, DELETE, PATCH';
            add_header 'Access-Control-Allow-Headers' 'Origin, X-Requested-With, Content-Type, Accept, Authorization, Cache-Control';
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            add_header 'Content-Length' 0;
            return 204;
        }
        
        # FastAPI specific timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;  # For file uploads
        proxy_read_timeout 300s;  # For long-running operations
        
        # Increase body size for file uploads
        client_max_body_size 100M;
    }
    
    # WebSocket support for FastAPI
    location /ws {
        proxy_pass http://127.0.0.1:{{ backend_port or 8000 }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    
    # FastAPI docs (disable in production)
    location /docs {
        proxy_pass http://127.0.0.1:{{ backend_port or 8000 }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Optional: Restrict access to docs
        # allow 127.0.0.1;
        # allow ::1;
        # deny all;
    }
    
    # OpenAPI schema
    location /openapi.json {
        proxy_pass http://127.0.0.1:{{ backend_port or 8000 }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Cache OpenAPI schema
        expires 1h;
        add_header Cache-Control "public";
    }
    
    # Health check
    location /health {
        proxy_pass http://127.0.0.1:{{ backend_port or 8000 }}/health;
        proxy_set_header Host $host;
        access_log off;
    }
    
    # Metrics endpoint (restrict access)
    location /metrics {
        proxy_pass http://127.0.0.1:{{ backend_port or 8000 }}/metrics;
        proxy_set_header Host $host;
        
        # Restrict to monitoring systems
        allow 127.0.0.1;
        allow ::1;
        deny all;
    }
    
    # Security
    location ~ /\. {
        deny all;
    }
}