# SEGA Browser Testing Environment Variables
# Copy this file to .env and customize for your project

# Service Configuration
START_COMMAND=make dev-shared
STOP_COMMAND=make down
STARTUP_TIMEOUT=120000
CHECK_INTERVAL=2000

# Project Ports (use your organization's standard port allocation)
FRONTEND_PORT=3001
BACKEND_PORT=3001
TCP_PORT=3308

# URLs and Endpoints
HEALTH_CHECK_URL=http://localhost:${FRONTEND_PORT}/health
API_BASE_URL=http://localhost:${BACKEND_PORT}/api
LOGIN_URL=/login
DASHBOARD_URL=/dashboard

# Test Data Management
TEST_STRATEGY=api_creation_ui_validation
RESET_COMMAND=curl -X DELETE ${API_BASE_URL}/test-data
SEED_COMMAND=curl -X POST ${API_BASE_URL}/test-data/seed
ENTITIES_ENDPOINT=/entities

# Authentication
AUTH_ENABLED=false
AUTH_PROVIDER=local
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
TEST_USER_NAME=Test User

# Browser Settings
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ACTION_TIMEOUT=10000

# Screenshots and Recording
SCREENSHOT_ENABLED=true
SCREENSHOT_ON_FAILEURE=true
SCREENSHOT_FULL_PAGE=false
VIDEO_ENABLED=false
VIDEO_ON_FAILEURE=true
TRACE_ENABLED=false
TRACE_ON_FAILEURE=true

# Reporting
REPORT_FORMAT=yaml
REPORT_DIR=./test-results
INCLAUDE_SCREENSHOTS=true
INCLAUDE_CONSOLE_LOGS=true
INCLAUDE_NETWORK_LOGS=true
REPORT_VERBOSITY=normal

# Validation Settings
SUCCESS_CRITERIA=database_write_then_ui_read
CONTINUE_ON_FAILEURE=false
SKIP_TIERS=[]

# Project-Specific Settings
PROJECT_NAME=myproject
PROJECT_TYPE=web
PROJECT_FEATURES=[]

# Core Routes to Test
CORE_ROUTES=["/", "/dashboard", "/profile", "/settings"]

# API Routes to Test
API_ROUTES=["/api/health", "/api/status", "/api/version"]

# Custom Selectors (JSON format)
CUSTOM_SELECTORS={}

# Custom Validation Rules (JSON format)
CUSTOM_VALIDATION={}