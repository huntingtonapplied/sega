{
  "name": "sega-desktop",
  "version": "1.0.0",
  "description": "SEGA Infrastructure Orchestration Desktop Application",
  "main": "dist/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\" \"npm run dev:python\"",
    "dev:main": "tsc -w -p tsconfig.main.json",
    "dev:renderer": "vite",
    "dev:python": "cd src/python && python3 main.py --reload",
    "build": "npm run build:main && npm run build:renderer && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:preload": "tsc -p tsconfig.preload.json",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:all": "npm run build && electron-builder -mwl",
    "postinstall": "npm run install-shared",
    "python:install": "pip install -r src/python/requirements.txt",
    "test": "jest",
    "test:integration": "jest --config=jest.integration.config.js",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit && electron-builder install-app-deps --audit",
    "install-shared": "cd ~/workspace && npm install --cache ~/workspace/.npm-cache"
  },
  "keywords": [
    "electron",
    "sega",
    "infrastructure",
    "orchestration",
    "deployment",
    "devops",
    "desktop",
    "sega-platform"
  ],
  "author": "SEGA Development Team",
  "license": "UNLICENSED",
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@mui/x-date-pickers": "^6.18.3",
    "@mui/x-charts": "^6.18.3",
    "axios": "^1.6.2",
    "better-sqlite3": "^9.2.2",
    "date-fns": "^2.30.0",
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "cytoscape": "^3.26.0",
    "react-cytoscape": "^2.0.0",
    "react-grid-layout": "^1.4.4",
    "recharts": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.5",
    "@types/node": "^20.10.4",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@types/cytoscape": "^3.19.16",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "electron": "^27.1.3",
    "electron-builder": "^24.9.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  },
  "homepage": "https://segaapp.com",
  "build": {
    "appId": "com.sega.desktop",
    "productName": "SEGA Infrastructure Orchestration",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "src/python/**/*",
      "db/**/*",
      "_internal/environments/_internal/environments/node_modules/**/*"
    ],
    "extraFiles": [
      {
        "from": "src/python",
        "to": "python",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/*.pyc"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": "dmg"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage"
    },
    "publish": {
      "provider": "github",
      "owner": "example",
      "repo": "sega"
    }
  }
}