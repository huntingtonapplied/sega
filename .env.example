# =============================================================================
# SEGA - Cross-Domain Deployment Platform Environment Variables
# FLEET Deployment Standards Compliant
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control
# =============================================================================

# Project Identification
PROJECT_NAME=sega
PROJECT_ID=5
ENVIRONMENT=development
NODE_ENV=development
DEBUG=false

# =============================================================================
# Infrastructure (Database & Caching)
# =============================================================================

# PostgreSQL Database
POSTGRES_DB=sega_dev
POSTGRES_USER=fleet
POSTGRES_PASSWORD=secure_db_password_here  # Required - no default

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secure_redis_password_here  # Required - no default
REDIS_DB=0

# Database URLs (automatically constructed)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/${REDIS_DB}

# =============================================================================
# SEGA Application Security
# =============================================================================

# JWT and Session Management
SEGA_JWT_SECRET_KEY=  # Required - no default (use: openssl rand -hex 32)
SEGA_API_KEY=  # Required - no default (use: openssl rand -hex )
SEGA_SESSION_SECRET=  # Required - no default (use: openssl rand -hex 32)
SEGA_ENCRYPTION_KEY=  # Required - no default (use: openssl rand -hex )
SEGA_CSRF_SECRET=  # Required - no default (use: openssl rand -hex 32)

# Deployment Engine Security
DEPLOYMENT_ENGINE_SECRET=  # Required - no default (use: openssl rand -hex 32)
HARDWARE_ACCESS_SECRET=  # Required - no default (use: openssl rand -hex 32)

# =============================================================================
# Cloud Provider Credentials (AWS ECS Deployment)
# =============================================================================

# AWS Credentials for ECS Deployment
#
# Preferred (local dev / workstation): use a named profile from ~/.aws/credentials.
# Configure once with `aws configure --profile huntingtonapplied`, then set:
AWS_PROFILE=huntingtonapplied
#
# Fallback (CI / containers without ~/.aws): provide raw credentials instead.
# If AWS_PROFILE is set, leave the two below empty so the profile takes precedence.
AWS_ACCESS_KEY_ID=  # leave empty when AWS_PROFILE is set
AWS_SECRET_ACCESS_KEY=  # leave empty when AWS_PROFILE is set
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ECS Configuration
ECS_CLUSTER_NAME=sega-cluster
ECS_SERVICE_NAME=sega-service

# =============================================================================
# Kubernetes Deployment Engine
# =============================================================================

# Kubernetes Configuration
KUBERNETES_CONFIG=  # Required for K8s - path to kubeconfig file
KUBERNETES_TOKEN=  # Required for K8s - service account token
KUBERNETES_NAMESPACE=sega-dev
KUBERNETES_CONTEXT=default

# =============================================================================
# Ansible Bare-Metal/Embedded Deployment
# =============================================================================

# Ansible Configuration
ANSIBLE_VAULT_PASSWORD=  # Required for bare-metal deployment - no default
ANSIBLE_HOST_KEY_CHECKING=false
ANSIBLE_PRIVATE_KEY_FILE=  # Path to SSH private key for Ansible
ANSIBLE_REMOTE_USER=deploy

# =============================================================================
# Hardware Access and Device Programming
# =============================================================================

# SSH Keys for Device Access
SSH_PRIVATE_KEY=  # Required for device access - path to private key
SSH_PUBLIC_KEY=  # Path to public key
SSH_KNOWN_HOSTS=  # Path to known_hosts file

# FPGA Programming
FPGA_PROGRAMMER_KEY=  # Required for FPGA deployment - no default
OPENFPGALOADER_PATH=/usr/local/bin/openFPGALoader

# Embedded Device Programming
DEVICE_PROGRAMMER_CONFIG=  # Required for embedded deployment - config path
EMBEDDED_TOOLCHAIN_PATH=/opt/embedded-toolchain

# =============================================================================
# Container Registry Credentials
# =============================================================================

# Docker Registry
DOCKER_REGISTRY_USER=  # Required for private registries
DOCKER_REGISTRY_PASS=  # Required for private registries
DOCKER_REGISTRY_URL=docker.io

# =============================================================================
# SEGA API Server Configuration
# =============================================================================

# API Server Settings
SEGA_API_HOST=0.0.0.0
SEGA_API_PORT=8015
SEGA_API_DEBUG=false

# gRPC Streaming Service
SEGA_GRPC_HOST=0.0.0.0
SEGA_GRPC_PORT=50051
SEGA_GRPC_MAX_MESSAGE_SIZE=4  # 4MB

# Monitoring API
SEGA_MONITORING_HOST=0.0.0.0
SEGA_MONITORING_PORT=5055

# Admin Interface
SEGA_ADMIN_HOST=0.0.0.0
SEGA_ADMIN_PORT=5056

# Development Server
SEGA_DEV_SERVER_HOST=0.0.0.0
SEGA_DEV_SERVER_PORT=5057

# =============================================================================
# External Services Integration
# =============================================================================

# FLEET Ecosystem Integration
FLEET_ROOT=/home/testuser/fleet
FLEET_SHARED_VENV=${FLEET_ROOT}/.shared/venv
FLEET_SHARED_NODE_MODULES=${FLEET_ROOT}/.shared/node_modules

# Telemetry Integration (Legacy)
TELEMETRY_API_URL=http://localhost:3308/api
TELEMETRY_WEBSOCKET_URL=ws://localhost:3308/ws

# =============================================================================
# METRICS CONFIGURATION
# =============================================================================
# Core Metrics
METRICS_ENABLED=true
METRICS_INTERVAL=10
PROJECT_ID=SEGA

# Telemetry Reporting
SEGA_TELEMETRY_TCP_HOST=telemetry.example.local
SEGA_TELEMETRY_TCP_PORT=3308
TELEMETRY_API_KEY=${TELEMETRY_API_KEY}

# Optional: Prometheus compatibility
METRICS_PROMETHEUS_PORT=9090
METRICS_DEBUG_ENDPOINT=/metrics

# =============================================================================
# Development Settings
# =============================================================================

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=/var/log/sega/sega.log

# Testing Configuration
TEST_DATABASE_URL=postgresql://test:test@localhost:5432/test_sega
TEST_REDIS_URL=redis://localhost:6379/5

# Development Features
ENABLE_SWAGGER_UI=true
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILING=false

# =============================================================================
# Performance and Scaling
# =============================================================================

# Worker Configuration
WORKER_PROCESSES=4
WORKER_CONNECTIONS=1000
WORKER_TIMEOUT=30

# Deployment Performance
MAX_CONCURRENT_DEPLOYMENTS=5
DEPLOYMENT_TIMEOUT=3600  # 1 hour
ROLLBACK_TIMEOUT=600     # 10 minutes

# Hardware Programming Timeouts
FPGA_PROGRAMMING_TIMEOUT=300   # 5 minutes
EMBEDDED_FLASH_TIMEOUT=600     # 10 minutes
DEVICE_DISCOVERY_TIMEOUT=30    # 30 seconds

# =============================================================================
# Monitoring and Observability
# =============================================================================

# Metrics Collection
ENABLE_METRICS=true
METRICS_EXPORT_INTERVAL=60  # seconds
METRICS_RETENTION_DAYS=30

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30    # seconds
HEALTH_CHECK_TIMEOUT=5     # seconds
HEALTH_CHECK_RETRIES=3

# =============================================================================
# Security Configuration
# =============================================================================

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept

# SSL/TLS Configuration (for production)
SSL_CERT_PATH=  # Path to SSL certificate
SSL_KEY_PATH=   # Path to SSL private key
SSL_CA_PATH=    # Path to CA bundle

# =============================================================================
# Feature Flags
# =============================================================================

# Deployment Engine Features
ENABLE_ECS_DEPLOYMENT=true
ENABLE_K8S_DEPLOYMENT=true
ENABLE_ANSIBLE_DEPLOYMENT=true
ENABLE_FPGA_DEPLOYMENT=true

# API Features
ENABLE_GRPC_STREAMING=true
ENABLE_REST_API=true
ENABLE_WEBSOCKET_API=false

# Hardware Features
ENABLE_HARDWARE_DISCOVERY=true
ENABLE_DEVICE_PROGRAMMING=true
ENABLE_FIRMWARE_VALIDATION=true

# =============================================================================
# Environment-Specific Overrides
# =============================================================================

# Development Environment
# DEBUG=true
# LOG_LEVEL=DEBUG
# ENABLE_SWAGGER_UI=true

# Staging Environment  
# DEBUG=false
# LOG_LEVEL=INFO
# RATE_LIMIT_REQUESTS_PER_MINUTE=500

# Production Environment
# DEBUG=false
# LOG_LEVEL=WARNING
# ENABLE_SWAGGER_UI=false
# RATE_LIMIT_REQUESTS_PER_MINUTE=1000